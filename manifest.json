{
  "manifest_version": 3,
  "name": "AI 整页翻译",
  "key": "",
  "version": "1.1.1",
  "description": "基于大模型接口的网页整页翻译插件",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI 整页翻译"
  },
  "commands": {
    "translate-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "翻译当前页面"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js",
        "selection.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
